# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string. This example points at the docker-compose Postgres
# service reached from the host (bare-metal `uvicorn`/`python -m app.seed`), not from
# inside another container — the app container in docker-compose.yml sets its own
# DATABASE_URL using the "postgres" service hostname instead of "localhost".
# Leave this unset entirely to fall back to a local SQLite file for zero-config dev.
DATABASE_URL=postgresql+psycopg://helpdesk:helpdesk@localhost:5432/helpdesk

# Random secret used to sign JWTs. Generate one with e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-to-a-random-secret

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password assigned to every seeded demo user.
DEMO_PASSWORD=password123
